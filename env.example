# Copy to .env for local dev, and set these in your host (Vercel/Netlify) → Environment Variables.
# The token is a SECRET — it stays here / in the host, never in the browser or the repo.

# Airtable Personal Access Token (create at https://airtable.com/create/tokens)
# Scopes needed: data.records:read, data.records:write
# Access: the "Core 4+2" base only
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Core 4+2 base id (already correct — change only if you clone the base)
AIRTABLE_BASE_ID=appfMP8uezWpG5Z2d
